  - text: "\u8FD8\u6709\u4E00\u4E9B\u4ED6\u4EEC\u7684\u4E2A\u4EBA\u7528\u54C1\uFF0C\u8FD8\u662F\u7ED9\u4ED6\u4EEC\u7559\u7740\u5427\u3002"
