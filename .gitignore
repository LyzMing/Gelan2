# =============================================================================
# Gelan2 — Unity 项目 .gitignore
#
# ⚠ 重要：本仓库把 Unity 工程放在子目录 Remiehzla/ 下，而不是仓库根目录。
#   因此下面所有 Unity 目录规则都写成 "**/..." 形式，保证在仓库根目录、
#   Remiehzla/ 以及任意层级都能命中。
#   旧写法 "/[Ll]ibrary/" 只匹配仓库根目录的 Library，导致
#   Remiehzla/Library（内含 50~130MB 的 Burst LLVM 二进制）被误提交。
#
# 基线：https://github.com/github/gitignore/blob/main/Unity.gitignore
# 提醒：GitHub 对单个文件 >100MB 直接拒收，>50MB 会告警；
#      确实必须入库的大资源请改用 Git LFS，而不是塞进普通提交。
# =============================================================================

# -----------------------------------------------------------------------------
# Unity 生成目录（可再生成、体积巨大 / 含本机私有数据 → 必须忽略）
# -----------------------------------------------------------------------------
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/
**/[Mm]emory[Cc]aptures/
**/[Rr]ecordings/
**/[Aa]ssets/[Ss]ceneDependencyCache*
.utmp/
*.log

# -----------------------------------------------------------------------------
# Unity 运行/测试/崩溃产生的杂项产物
# -----------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
~UnityDirMonSyncFile~*
mono_crash.*
tmpinst-dir.stamp
.dirstamp

# 崩溃恢复场景
**/[Aa]ssets/_Recovery/
**/[Aa]ssets/_Recovery.meta

# 测试框架自动生成
**/[Aa]ssets/Resources/PerformanceTestRunInfo.json
**/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
**/[Aa]ssets/Resources/PerformanceTestRunSettings.json
**/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
**/[Aa]ssets/InitTestScene*.unity
**/[Aa]ssets/InitTestScene*.unity.meta

# -----------------------------------------------------------------------------
# 构建产物 / 分发包（单文件通常都很大）
# -----------------------------------------------------------------------------
**/*_BackUpThisFolder_ButDontShipItWithYourGame/
**/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app
*.ipa
*.exe

# -----------------------------------------------------------------------------
# 编辑器 / IDE（本机个性化配置）
# -----------------------------------------------------------------------------
.vs/
.vsconfig
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user

# 上述文件对应的 .meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# -----------------------------------------------------------------------------
# 版本控制 / 本机元数据
#   .plastic/ 是 Unity Version Control 的本机工作区缓存，换机器会重建
# -----------------------------------------------------------------------------
.plastic/
*.private
*.private.meta

# -----------------------------------------------------------------------------
# 插件 / 第三方资源自动生成
# -----------------------------------------------------------------------------
# 资源商店插件（按需解除注释）
# **/[Aa]ssets/AssetStoreTools*
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Blender 备份文件
**/[Aa]ssets/**/*.blend1
**/[Aa]ssets/**/*.blend1.meta

# TouchDesigner 缓存
**/[Aa]ssets/**/TDImportCache/
**/[Aa]ssets/**/TDImportCache.meta

# Addressables 构建中间产物
**/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
**/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
**/[Aa]ssets/AddressableAssetsData/link.xml
**/[Aa]ssets/AddressableAssetsData/link.xml.meta
**/[Aa]ssets/Addressables_Temp/
**/[Aa]ssets/Addressables_Temp.meta
**/[Aa]ssets/StreamingAssets/aa/
**/[Aa]ssets/StreamingAssets/aa.meta
**/[Ss]erverData/

# EDM4U（External Dependency Manager for Unity）生成
**/[Aa]ssets/GeneratedLocalRepo/
**/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle 生成
**/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
**/[Aa]ssets/Plugins/Android/**/local.properties

# Visual Scripting 自动生成
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit 生成
**/[Uu]IElementsSchema/

# Shader / Compute 缓存的旧命名
**/*.shadercache
**/*.computecache

# -----------------------------------------------------------------------------
# 操作系统垃圾文件
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# -----------------------------------------------------------------------------
# 临时预览图 / 分析产物（不入库）
# -----------------------------------------------------------------------------
/puzzle_*.png

# -----------------------------------------------------------------------------
# MCP（Unity 编辑器桥接）本机工具目录
#   Tools/mcp-unity-server 由 mcp-unity 的 Server~ 源码构建，可 npm install + build 重建
# -----------------------------------------------------------------------------
/Tools/mcp-unity-server/node_modules/
/Tools/mcp-unity-server/build/
/Tools/.npm-cache/
/.tmp-npm-cache/
